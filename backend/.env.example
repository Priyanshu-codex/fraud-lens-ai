# ==============================================================================
# FraudLens AI — Backend Environment Configuration (.env.example)
# ==============================================================================

# Supabase Database Configuration (Server-Side Only)
# CRITICAL SECURITY RULE: NEVER expose SUPABASE_SERVICE_ROLE_KEY to the browser or frontend!
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: Supabase Anon Key (used as fallback if service role key is not set)
SUPABASE_ANON_KEY=your-supabase-anon-key

# CORS & Server Settings
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
