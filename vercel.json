{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "{backend/**,backend/models/**}",
      "excludeFiles": "{node_modules/**,.next/**,tests/**,__tests__/**,**/*.test.py,**/test_*.py,data/**,*.csv,ml/training/**,ml/reports/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
