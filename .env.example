# ==============================================================================
# FraudLens AI — Frontend Environment Configuration (.env.example)
# Configure these variables in your Vercel Project Settings:
# Settings -> Environment Variables (Production, Preview, Development)
# ==============================================================================

# Backend API URL (Frontend -> FastAPI)
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# Vercel production:
# NEXT_PUBLIC_API_URL=https://your-fastapi-backend.onrender.com/api

# Supabase Configuration (Frontend - Browser Public Anon)
# CRITICAL SECURITY: NEVER expose SUPABASE_SERVICE_ROLE_KEY to the browser!
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
