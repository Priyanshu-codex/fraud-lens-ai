# ==============================================================================
# FraudLens AI — Production & Local Environment Configuration
# ==============================================================================
# In unified single-deployment mode on Vercel, the Next.js frontend and FastAPI
# backend run within the SAME Vercel project.
# Configure these variables in Vercel Project Settings:
# Settings -> Environment Variables (Production, Preview, Development)
# ==============================================================================

# --- API URL Resolution ---
# Unified Vercel deployment (Default / Recommended):
# Frontend automatically uses same-origin relative /api. Leave NEXT_PUBLIC_API_URL
# unset or set to /api.
# NEXT_PUBLIC_API_URL=/api
# Local development fallback:
# NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Optional: External backend proxy (if running backend on dedicated host)
# BACKEND_URL=https://your-backend.onrender.com

# --- Supabase Database (Server-side FastAPI) ---
# CRITICAL SECURITY: NEVER expose SUPABASE_SERVICE_ROLE_KEY to the browser!
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# --- Supabase Database (Browser-side Next.js) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- CORS & Security Settings ---
FRONTEND_URL=https://fraud-lens-ai-lovat.vercel.app
CORS_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$
